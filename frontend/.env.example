# Frontend build-time config (Vite). Copy to .env.local for local overrides,
# or set these as Environment Variables in the Vercel project.

# Backend API origin for production (no trailing slash, no /api suffix).
# Leave UNSET for local dev (uses the Vite proxy to http://localhost:8000)
# or when proxying /api through a Vercel rewrite.
# Example:
# VITE_API_BASE_URL=https://cti-api.onrender.com
