# Copy this file to .env and fill in your API keys
# All keys are optional, the app works without them but with reduced functionality

# Deployed frontend origin so CORS allows it (no trailing slash). Set this when
# the frontend is on Vercel and the backend is on a separate host.
# FRONTEND_URL=https://cti.vercel.app

# VirusTotal - https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB - https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Shodan - https://account.shodan.io/
SHODAN_API_KEY=

# GreyNoise - https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# AlienVault OTX - https://otx.alienvault.com/settings
OTX_API_KEY=

# urlscan.io
URLSCAN_API_KEY=

# Threat-sharing & monitoring integrations (empty = "not configured" status)
MISP_URL=
MISP_KEY=
OPENCTI_URL=
OPENCTI_TOKEN=
DARKWEB_FEED_URL=

# Feed polling interval in minutes (per-feed schedules override this)
FEED_POLL_INTERVAL=30

# Database URL (default: SQLite file in project root).
# For a mounted disk use an absolute path, e.g. sqlite+aiosqlite:////data/cti.db
DATABASE_URL=sqlite+aiosqlite:///./cti.db
